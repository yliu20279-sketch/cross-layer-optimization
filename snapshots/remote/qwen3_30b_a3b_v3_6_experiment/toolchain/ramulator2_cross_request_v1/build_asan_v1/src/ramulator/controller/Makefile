# Special targets to cleanup operation of make.

# Special rule to run CMake to check the build system integrity.
# No rule that depends on this can have commands that come from listfiles
# because they might be regenerated.
cmake_check_build_system:
	cd /mnt/sda1/h3240101068/qwen3_30b_a3b_v3_6_experiment/toolchain/ramulator2_cross_request_v1/build_asan_v1 && $(CMAKE_COMMAND) -P /mnt/sda1/h3240101068/qwen3_30b_a3b_v3_6_experiment/toolchain/ramulator2_cross_request_v1/build_asan_v1/CMakeFiles/VerifyGlobs.cmake
	cd /mnt/sda1/h3240101068/qwen3_30b_a3b_v3_6_experiment/toolchain/ramulator2_cross_request_v1/build_asan_v1 && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

