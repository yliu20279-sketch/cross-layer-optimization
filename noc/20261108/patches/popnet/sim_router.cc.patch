+// This predicate is deliberately conservative: every action that can make a
+// grant, draw RNG, transfer a flit, or admit a source packet prevents skipping.
+bool sim_router_template::quiescent_until(time_type now,time_type& limit){
+    if(pipelineStageDelay()!=1||!finite_source_capacity())return false;
+    for(long p=0;p<output_ports_;++p)if(!output_module_.outbuffers(p).empty())return false;
+    for(long p=0;p<physic_ports_;++p)for(long v=0;v<vc_number_;++v){
+        const auto state=input_module_.state(p,v);
+        if(state==SW_TR_||(state==ROUTING_&&!cached_stalled_local_header(p,v)))return false;
+        if(state==HOME_&&!input_module_.input(p,v).empty()&&!AuxBridge::get().mesh_full(address_.front()))return false;
+        if(state==SW_AB_){
+            const auto out=input_module_.crouting(p,v);
+            if(out.first<0||out.second<0)return false;
+            if(output_module_.counter(out.first,out.second)>0&&output_module_.localcounter(out.first)>0)return false;
+        }
+        if(state==VC_AB_)for(const auto& out:input_module_.routing(p,v)){
+            const bool available=output_module_.usage(out.first,out.second)==FREE_;
+            if(available&&(configuration::ap().vc_share()==SHARE_||output_module_.counter(out.first,out.second)==buffer_size_))return false;
+        }
+    }
+    if(!localInputTraces.empty()){
+        const auto& packet=localInputTraces.front();
+        if(packet.startTime>now+S_ELPS_)limit=std::min(limit,packet.startTime);
+        else if(!input_module_.ibuff_full()){
+            long queued=0;for(long v=0;v<vc_number_;++v)queued+=input_module_.input(0,v).size();
+            if(queued+packet.packetSize<=finite_source_capacity())return false;
+        }
+    }
+    return true;
+}
+bool sim_router_template::completely_idle_until(time_type now,time_type&limit){
+    if(pipelineStageDelay()!=1||!finite_source_capacity())return false;
+    for(long p=0;p<output_ports_;++p)if(!output_module_.outbuffers(p).empty())return false;
+    for(long p=0;p<physic_ports_;++p)for(long v=0;v<vc_number_;++v)
+        if(!input_module_.input(p,v).empty()||input_module_.state(p,v)!=INIT_)return false;
+    if(!localInputTraces.empty()){
+        const auto&packet=localInputTraces.front();
+        auto start=packet.startTime;
+        if(ProgramFences::get().command_clock()){
+            auto trans=sim_foundation::wsf().protoEngine().get_trans(packet.id);
+            start=ProgramFences::get().issue_time(address_.front(),std::uint64_t(trans->protoDesc),true,long(start));
+            if(start<0)return false;
+        }
+        if(start<=now+1)return false;
+        limit=std::min(limit,start);
+    }
+    return true;
