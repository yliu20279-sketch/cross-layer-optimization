+namespace {
+int stable_event_mode(){static const int mode=[](){const char*p=std::getenv("NOC_STABLE_EVENT_ORDER");return p?std::atoi(p):0;}();return mode;}
+int event_phase(mess_type type){
+    if(stable_event_mode()!=2)return int(type);
+    // Sample returning credits and arriving wires before the clocked router.
+    switch(type){
+    case RECONFIGURATION:return 0;
+    case CREDIT_:return 1;
+    case WIRE_:return 2;
+    case AUX_ARRIVAL_:return 3;
+    case PHASE_READY_:return 4;
+    case CONTROL_TICK_:return 5;
+    case EVG_:return 6;
+    case ROUTER_:return 7;
+    case NI_SERVICE_:return 8;
+    }
+    return 9;
+}
+bool event_less(const mess_event&a,const mess_event&b){
+    if(a.event_start()!=b.event_start())return a.event_start()<b.event_start();
+    if(!stable_event_mode())return false;
+    const auto x=event_phase(a.event_type()),y=event_phase(b.event_type());
+    if(x!=y)return x<y;
+    if(a.src()!=b.src())return a.src()<b.src();
+    if(a.des()!=b.des())return a.des()<b.des();
+    if(a.event_type()==WIRE_||a.event_type()==CREDIT_){
+        if(a.pc()!=b.pc())return a.pc()<b.pc();
+        if(a.vc()!=b.vc())return a.vc()<b.vc();
+    }
+    if(a.event_type()==WIRE_||a.event_type()==AUX_ARRIVAL_){
+        if(a.get_flit().getPacketId()!=b.get_flit().getPacketId())return a.get_flit().getPacketId()<b.get_flit().getPacketId();
+        return a.get_flit().sequence()<b.get_flit().sequence();
+    }
+    if(a.event_type()==ROUTER_)return a.getRoutingPeriod()<b.getRoutingPeriod();
+    return false;
+}
+}
+bool operator<(const mess_event & a, const mess_event & b) {return event_less(a,b);}
