diff --git a/sim/priority_router_main.cpp b/sim/priority_router_main.cpp
new file mode 100644
index 0000000..a5baa02
--- /dev/null
+++ b/sim/priority_router_main.cpp
@@ -0,0 +1,29 @@
+#include "Vxy_router.h"
+#include "verilated.h"
+#include <iostream>
+#include <stdexcept>
+static void step(Vxy_router& d){d.clk=0;d.eval();d.clk=1;d.eval();d.clk=0;d.eval();}
+static void reset(Vxy_router& d){
+ d.clk=0;d.reset=1;d.in_valid=0;
+ for(int i=0;i<5;i++){d.out_credit[i]=0;for(int k=0;k<9;k++)d.in_flit[i][k]=0;}
+ step(d);step(d);d.reset=0;d.eval();
+}
+static void enqueue(Vxy_router& d,int vn,int dst){
+ d.in_valid=1;for(int k=0;k<9;k++)d.in_flit[0][k]=0;
+ const int opcode=vn==3?5:vn==2?2:vn==1?1:3;
+ d.in_flit[0][7]=(unsigned(opcode)<<28)|(unsigned(dst)<<24);d.in_flit[0][8]=(vn<<2)|3;
+ d.eval();if(!(d.in_credit[0]&(1<<vn)))throw std::runtime_error("input blocked");step(d);
+}
+int main(int argc,char**argv){
+ Verilated::commandArgs(argc,argv);Vxy_router d;reset(d);
+ for(int vn=0;vn<4;vn++)enqueue(d,vn,0);
+ d.in_valid=0;d.out_credit[4]=15;d.eval();
+ for(int vn=3;vn>=0;vn--){
+  std::cout<<"expected VN "<<vn<<" output valid "<<unsigned(d.out_valid)<<" actual VN "<<(d.out_flit[4][8]>>2)<<std::endl;
+  if(!(d.out_valid&16)||((d.out_flit[4][8]>>2)&3)!=unsigned(vn))throw std::runtime_error("fixed class order violated");step(d);
+ }
+ reset(d);enqueue(d,0,1);enqueue(d,3,0);d.in_valid=0;d.out_credit[0]=15;d.out_credit[4]=15;d.eval();
+ if(!(d.out_valid&16)||(d.out_valid&1))throw std::runtime_error("cross-output input priority violated");
+ step(d);if(!(d.out_valid&1)||((d.out_flit[0][8]>>2)&3)!=0)throw std::runtime_error("low class failed to resume");
+ std::cout<<"PASS fixed class priority and cross-output input conflict"<<std::endl;
+}
diff --git a/tests/priority_unit_tb.sv b/tests/priority_unit_tb.sv
new file mode 100644
index 0000000..0de8176
--- /dev/null
+++ b/tests/priority_unit_tb.sv
@@ -0,0 +1,39 @@
+module priority_unit_tb;
+ import noc_pkg::*;
+ logic clk=0,reset=1;
+ always #5 clk=~clk;
+ logic [4:0] in_valid,out_valid;
+ flit_t in_flit[5],out_flit[5];
+ logic [3:0] in_credit[5],out_credit[5];logic busy;
+ xy_router #(.ID(0),.TYPE_PRIORITY(1)) dut(.*);
+ task automatic enqueue(input int v,input int dst);
+  @(negedge clk);
+  in_valid=1;in_flit[0]=frame(header(v==3?CONFIG:v==2?DATAS:v==1?GETS:MOE_DATA,4'd0,4'(dst),32'(v+1),0,0),v,1,1);
+  #1;assert(in_credit[0][v])else $fatal(1,"input blocked");
+  @(posedge clk);#1;
+ endtask
+ task automatic reset_dut;
+  @(negedge clk);reset=1;in_valid=0;
+  for(int p=0;p<5;p++)begin in_flit[p]='0;out_credit[p]=0;end
+  repeat(2)@(posedge clk);
+  @(negedge clk);reset=0;
+ endtask
+ initial begin
+  in_valid=0;for(int p=0;p<5;p++)begin in_flit[p]='0;out_credit[p]=0;end
+  reset_dut();
+  for(int v=0;v<4;v++)enqueue(v,0);
+  @(negedge clk);in_valid=0;out_credit[4]=15;
+  for(int v=3;v>=0;v--)begin
+   #1;assert(out_valid[4]&&out_flit[4][259:258]==v)else $fatal(1,"fixed VN priority violated");
+   @(posedge clk);@(negedge clk);
+  end
+  reset_dut();
+  enqueue(0,1);enqueue(3,0);
+  @(negedge clk);in_valid=0;out_credit[0]=15;out_credit[4]=15;
+  #1;assert(out_valid[4]&&!out_valid[0]&&out_flit[4][259:258]==3)else $fatal(1,"cross-output input conflict violated priority");
+  @(posedge clk);@(negedge clk);
+  #1;assert(out_valid[0]&&out_flit[0][259:258]==0)else $fatal(1,"low class failed to resume");
+  $display("PASS fixed class order and cross-output input conflict; no added queue or link");$finish;
+ end
+ initial begin #10000;$fatal(1,"priority unit timeout");end
+endmodule
